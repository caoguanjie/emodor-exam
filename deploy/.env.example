# =====================================================================
# EmodorRuleExam 环境变量示例（复制为 .env 后填写；02 册 5.3 + 07 册 6.4 配置清单）
# 安全约束：
#   1. 敏感值一律运行期注入——不写入源码/示例/测试，不提交仓库（.env 已加入 .gitignore）；
#   2. 全部密钥用 openssl 生成：
#      openssl rand -base64 48   # JWT_SECRET
#      openssl rand -base64 32   # EXAM_SHUFFLE_SECRET / APP_ENCRYPTION_KEY / 实名与媒体票据密钥
#   3. .env 文件权限 600，仅运维持有；生产密钥轮换见 07 册 6.4。
# 本地真实联调：npm --prefix server run env:init；填写根目录 .env 后执行 env:check、start:local。
# 填写与 Compose 注入说明：deploy/real-h5-env.md。本示例保持不含真实凭据。
# =====================================================================

# ---- 数据库（MySQL 8.0，utf8mb4 / 0900_ai_ci 由 compose 启动参数固定）----
# DB_USERNAME/DB_PASSWORD 由 compose 注入 MySQL 自动创建业务账号（MYSQL_USER）：DB_USERNAME 不能为 root
DB_USERNAME=ruleexam
# 数据库口令：运行期生成，如 openssl rand -base64 24（必须非空，否则 MySQL 容器无法初始化）
DB_PASSWORD=
DB_DATABASE=ruleexam
# TypeORM/MySQL 连接池大小，默认 20；只接受正整数，非法值会使 API 启动失败
# DB_POOL_SIZE=20

# ---- 认证与考试安全 ----
# JWT 签名密钥（HS256，≥32 字符随机串；轮换策略见 07 册 2.1.3，过渡期另配 JWT_SECRET_PRIOR）
JWT_SECRET=
JWT_EXPIRES_IN=2h
# 试题与选项乱序 seed 派生密钥：独立于 JWT_SECRET、不参与周期轮换
# （仅在确认泄露且无 in_progress 考试记录时更换，07 册 3.2.1）
EXAM_SHUFFLE_SECRET=
# AI 配置文件加密密钥（AES-256-GCM，32 字节）
APP_ENCRYPTION_KEY=

# ---- 学员移动端短信登录 ----
# disabled=不提供真实短信登录；yunxin=网易云信 sendcode/verifycode。启用 yunxin 时下列三项必填。
SMS_PROVIDER=disabled
YUNXIN_SMS_APP_KEY=
YUNXIN_SMS_APP_SECRET=
YUNXIN_SMS_LOGIN_CODE_TEMPLATE_ID=
# YUNXIN_SMS_BASE_URL=https://sms.yunxinapi.com
# YUNXIN_SMS_TIMEOUT_SECONDS=5
# YUNXIN_SMS_LOGIN_RESEND_SECONDS=60
# YUNXIN_SMS_LOGIN_VERIFY_TTL_SECONDS=300
# YUNXIN_SMS_LOGIN_MAX_VERIFY_ATTEMPTS=5
# YUNXIN_SMS_LOGIN_PHONE_DAILY_LIMIT=10
# YUNXIN_SMS_LOGIN_IP_DAILY_LIMIT=100
# YUNXIN_SMS_REDIS_KEY_PREFIX=ruleexam:sms_auth
# 仅 test/development 可显式开启；production 开启会使服务启动失败。
SERVER_DEBUG_LOGIN_ENABLED=false

# ---- 学员实名认证与短期私有媒体票据 ----
# disabled=只读已有实名事实，不允许新核验；tencent=腾讯身份证 OCR + ImageRecognitionV2。
IDENTITY_PROVIDER=disabled
# 生产环境三项均必填；只要 IDENTITY_PROVIDER=tencent，即使非生产环境也必须稳定注入前两项。
# 三项都必须分别生成 32 字节 Base64 密钥，不能互相复用。
IDENTITY_DATA_ENCRYPTION_KEY=
IDENTITY_FINGERPRINT_SECRET=
MEDIA_TICKET_SECRET=
# IDENTITY_SESSION_TTL_SECONDS=600
# MEDIA_TICKET_TTL_SECONDS=300
# IDENTITY_PROVIDER=tencent 时 OCR/FaceID 必须同时开启并配置完整；ENDPOINT 仅允许腾讯官方 HTTPS 主机。
TENCENT_ID_CARD_OCR_ENABLED=false
TENCENT_ID_CARD_OCR_SECRET_ID=
TENCENT_ID_CARD_OCR_SECRET_KEY=
# TENCENT_ID_CARD_OCR_TOKEN=
# TENCENT_ID_CARD_OCR_ENDPOINT=https://ocr.tencentcloudapi.com
# TENCENT_ID_CARD_OCR_HTTP_TIMEOUT_SECONDS=10
TENCENT_FACEID_ENABLED=false
TENCENT_FACEID_SECRET_ID=
TENCENT_FACEID_SECRET_KEY=
# TENCENT_FACEID_TOKEN=
# TENCENT_FACEID_ENDPOINT=https://faceid.tencentcloudapi.com
# TENCENT_FACEID_HTTP_TIMEOUT_SECONDS=10

# ---- AI 服务（环境变量为初始兜底；super_admin 可在界面配置覆写，权威副本加密落盘）----
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_API_KEY=
# AI_MODEL=glm-4-flash
# SSRF 白名单例外（host 或 host:port，逗号分隔）：仅供本地开发/测试放行环回地址上的 Mock AI，
# 如 AI_EGRESS_ALLOW_HOSTS=127.0.0.1；生产环境必须保持为空（默认为空）。
# AI_EGRESS_ALLOW_HOSTS=
# 扫描版 PDF 自动按页走视觉输入，默认开启；模型需支持 OpenAI 兼容 image_url 内容块。
# AI_MULTIMODAL_ENABLED=true
# AI_MULTIMODAL_TRIGGER_CHARS=1000
# AI_MULTIMODAL_PAGES_PER_REQUEST=4
# AI_MULTIMODAL_DPI=144

# ---- 首次部署种子 ----
# 超级管理员（username=admin）初始口令：运行期生成，≥8 位；首次登录强制改密
ADMIN_INITIAL_PASSWORD=

# ---- 网络（可选）----
# Redis 键命名空间（默认空以兼容现有部署；测试运行应使用每次运行独立前缀）
REDIS_KEY_PREFIX=
# CORS 跨域白名单（完整来源，逗号分隔，如 https://exam.example.com）。缺省禁用跨域：
# 生产为 nginx 同源（web 静态与 /api 反代同域），开发走 Vite 代理亦同源；仅前端独立域名部署时配置
# CORS_ORIGINS=

# ---- 文件与存储（compose 内自动挂载）----
# 本地参数保存在项目根 .env，通过 start:local / node --env-file=.env 加载。
# COS 凭据复用 gooodwork 已有值；只从明确来源 import-cos，不能复制整份其它项目配置。
MEDIA_STORAGE_PROVIDER=local
COS_BUCKET=
COS_REGION=
COS_KEY_PREFIX=ruleexam/dev/
COS_SECRET_ID=
COS_SECRET_KEY=
# COS_SESSION_TOKEN=
# COS 模式缺必填值时启动失败；历史 local 行仍按原位置读取。
# MEDIA_UPLOAD_SESSION_TTL_SECONDS=86400
# MEDIA_UPLOAD_RECEIPT_TTL_SECONDS=2592000
# MEDIA_MULTIPART_THRESHOLD_BYTES=16777216
# MEDIA_UPLOAD_PART_SIZE_BYTES=8388608
# MEDIA_UPLOAD_PARALLEL_LIMIT=3
# MEDIA_UPLOAD_GRANT_TTL_SECONDS=1800
# MEDIA_FINALIZER_CONCURRENCY=2
# MEDIA_FINALIZER_LEASE_SECONDS=120
# MEDIA_FINALIZER_RENEW_SECONDS=30
# MEDIA_FINALIZER_MAX_ATTEMPTS=5
# MEDIA_ORPHAN_GRACE_SECONDS=86400
# 沿用gooodwork的COS短链；真云验证后切cos-signed，proxy保留受控代理。
MEDIA_DELIVERY_MODE=proxy
# 视频自动续签并保持位置，不把有效期当成观看时长；延长也会扩大已发链接的有效窗口。
MEDIA_READ_URL_TTL_SECONDS=300
MEDIA_VIDEO_URL_TTL_SECONDS=300
# PC/H5只放行精确HTTPS COS桶域名与正式媒体前缀；不得使用通配域名或identity/staging。
# VITE_COS_MEDIA_ORIGIN=https://<bucket>.cos.<region>.myqcloud.com
# VITE_COS_MEDIA_PREFIX=ruleexam/dev/media/
# UPLOAD_DIR=/app/data/uploads（容器内）
# MAX_UPLOAD_SIZE=50
# 受控媒体：显式值必须是十进制整数且位于支持范围内，否则 API 启动与部署检查均失败：
# 视频 1..536870912 字节（默认 536870912）、图片 1..104857600 字节（默认 10485760）、
# 像素 1..100000000（默认 25000000）、探测 1000..120000ms（默认 30000ms）。
# ffmpeg/ffprobe 必须在 API 运行环境可执行。修改图片/视频限额后，还须同步 nginx 的
# client_max_body_size=max(MEDIA_VIDEO_MAX_BYTES,MEDIA_IMAGE_MAX_BYTES)+1MiB，并执行：
# node deploy/check-media-limits.mjs deploy/nginx/default.conf
# MEDIA_VIDEO_MAX_BYTES=536870912
# MEDIA_IMAGE_MAX_BYTES=10485760
# MEDIA_IMAGE_MAX_PIXELS=25000000
# MEDIA_PROBE_TIMEOUT_MS=30000
# FFPROBE_PATH=ffprobe
# FFMPEG_PATH=ffmpeg
