# =====================================================================
# EmodorRuleExam 环境变量示例（复制为 .env 后填写；02 册 5.3 + 07 册 6.4 配置清单）
# 安全约束：
#   1. 敏感值一律运行期注入——不写入源码/示例/测试，不提交仓库（.env 已加入 .gitignore）；
#   2. 全部密钥用 openssl 生成：
#      openssl rand -base64 48   # JWT_SECRET
#      openssl rand -base64 32   # EXAM_SHUFFLE_SECRET / APP_ENCRYPTION_KEY
#   3. .env 文件权限 600，仅运维持有；生产密钥轮换见 07 册 6.4。
# =====================================================================

# ---- 数据库（MySQL 8.0，utf8mb4 / 0900_ai_ci 由 compose 启动参数固定）----
# DB_USERNAME/DB_PASSWORD 由 compose 注入 MySQL 自动创建业务账号（MYSQL_USER）：DB_USERNAME 不能为 root
DB_USERNAME=ruleexam
# 数据库口令：运行期生成，如 openssl rand -base64 24（必须非空，否则 MySQL 容器无法初始化）
DB_PASSWORD=
DB_DATABASE=ruleexam

# ---- 认证与考试安全 ----
# JWT 签名密钥（HS256，≥32 字符随机串；轮换策略见 07 册 2.1.3，过渡期另配 JWT_SECRET_PRIOR）
JWT_SECRET=
JWT_EXPIRES_IN=2h
# 试题与选项乱序 seed 派生密钥：独立于 JWT_SECRET、不参与周期轮换
# （仅在确认泄露且无 in_progress 考试记录时更换，07 册 3.2.1）
EXAM_SHUFFLE_SECRET=
# AI 配置文件加密密钥（AES-256-GCM，32 字节）
APP_ENCRYPTION_KEY=

# ---- AI 服务（环境变量为初始兜底；super_admin 可在界面配置覆写，权威副本加密落盘）----
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_API_KEY=
# AI_MODEL=glm-4-flash
# SSRF 白名单例外（host 或 host:port，逗号分隔）：仅供本地开发/测试放行环回地址上的 Mock AI，
# 如 AI_EGRESS_ALLOW_HOSTS=127.0.0.1；生产环境必须保持为空（默认为空）。
# AI_EGRESS_ALLOW_HOSTS=
# 扫描版 PDF 自动按页走视觉输入，默认开启；模型需支持 OpenAI 兼容 image_url 内容块。
# AI_MULTIMODAL_ENABLED=true
# AI_MULTIMODAL_TRIGGER_CHARS=1000
# AI_MULTIMODAL_PAGES_PER_REQUEST=4
# AI_MULTIMODAL_DPI=144

# ---- 首次部署种子 ----
# 超级管理员（username=admin）初始口令：运行期生成，≥8 位；首次登录强制改密
ADMIN_INITIAL_PASSWORD=

# ---- 网络（可选）----
# Redis 键命名空间（默认空以兼容现有部署；测试运行应使用每次运行独立前缀）
REDIS_KEY_PREFIX=
# CORS 跨域白名单（完整来源，逗号分隔，如 https://exam.example.com）。缺省禁用跨域：
# 生产为 nginx 同源（web 静态与 /api 反代同域），开发走 Vite 代理亦同源；仅前端独立域名部署时配置
# CORS_ORIGINS=

# ---- 文件与存储（compose 内自动挂载）----
# UPLOAD_DIR=/app/data/uploads（容器内）
# MAX_UPLOAD_SIZE=50
