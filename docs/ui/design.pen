                {
                  "type": "text",
                  "id": "rOOQh",
                  "name": "Tiptap JSON / 学员阅读映射 copy",
                  "fill": "$secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "questionBlock → 一题一屏，保留独立题目边界\nquestionStem → 只读段落、强调、引用及媒体\nquestionOption → 富内容 + 大触区选择状态\n媒体节点 → 缩略图、加载失败与预览\n答案与解析 → 仅交卷后、按权限展示\n\n表格/公式、填空/简答和大图预览为适配示例。\n最终节点类型需与 PC 题库 schema 对齐。",
                  "lineHeight": 1.9,
                  "fontFamily": "$font-ui",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
